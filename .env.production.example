# Supabase (server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Telegram Mini App / Bot
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_TELEGRAM_APP_URL=https://your-domain.example
NEXT_PUBLIC_BOT_USERNAME=YourBotUsername
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
SUPPORT_TELEGRAM_USERNAME=your_support

# Signed application session. Use at least 32 random characters in production.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Internal jobs / administration
CRON_SECRET=replace-with-a-long-random-secret
ADMIN_TELEGRAM_IDS=123456789

# Gift catalogue (optional key; public TonAPI limits apply when omitted)
TONAPI_KEY=

# Optional Telegram API credentials for tooling that explicitly uses MTProto.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local development only. Keep disabled in production.
DEV_AUTH_ENABLED=false
DEV_TELEGRAM_ID=
DEV_TELEGRAM_USERNAME=
DEV_TELEGRAM_FIRST_NAME=
