# Supabase (server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public app origin. Keep all three values on the same custom domain in production.
# Production requests that hit *.vercel.app are redirected to APP_CANONICAL_URL.
APP_CANONICAL_URL=https://your-domain.example
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_TELEGRAM_APP_URL=https://your-domain.example
NEXT_PUBLIC_BOT_USERNAME=YourBotUsername
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_USERNAME=YourBotUsername
# Optional numeric bot id. Helps recognize replies to the bot even if username changes.
TELEGRAM_BOT_ID=
SUPPORT_TELEGRAM_USERNAME=your_support

# OpenRouter conversational bot. The default router uses free models only.
# Primary key is tried first. Add backup keys as one comma-separated value.
OPENROUTER_PRIMARY_API_KEY=sk-or-v1-primary
OPENROUTER_API_KEYS=sk-or-v1-backup1,sk-or-v1-backup2,sk-or-v1-backup3
OPENROUTER_MODEL=openrouter/free
# Legacy single-key fallback, optional.
OPENROUTER_API_KEY=

# Signed application session. Use at least 32 random characters in production.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Internal jobs / administration
CRON_SECRET=replace-with-a-long-random-secret
ADMIN_TELEGRAM_IDS=123456789

# Gift catalogue (optional key; public TonAPI limits apply when omitted)
TONAPI_KEY=

# Optional Telegram API credentials for tooling that explicitly uses MTProto.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local development only. Keep disabled in production.
DEV_AUTH_ENABLED=false
DEV_TELEGRAM_ID=
DEV_TELEGRAM_USERNAME=
DEV_TELEGRAM_FIRST_NAME=

# Bot must be an administrator of this public channel for reliable getChatMember checks.
TELEGRAM_MAIN_CHANNEL_USERNAME=Meme_X_Market
