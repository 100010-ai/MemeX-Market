# Supabase — server
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase — Realtime/browser public key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy alternative:
# SUPABASE_ANON_KEY=...

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Telegram IDs used only as real-source catalog inventory for MXM global Gift market.
# These accounts' real Telegram Unique Gifts are imported as metadata/media references;
# MXM ownership remains virtual and independent from Telegram ownership.
MARKET_CATALOG_TELEGRAM_IDS=123456789,987654321

# Optional Telegram in-app diagnostics admin
ADMIN_TELEGRAM_IDS=123456789

# LOCAL-ONLY God Mode. Never enable this on Vercel/production.
MXM_LOCAL_ADMIN_ENABLED=true
MXM_LOCAL_ADMIN_TOKEN=replace-with-a-long-local-token-minimum-24-characters
