# Public browser configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BOT_USERNAME=MemeXMarketBot
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Session / cron secrets
SESSION_SECRET=
CRON_SECRET=

# Production owner access at /admin. Keep ADMIN_OWNER_KEY server-only and use
# at least 32 random characters. ADMIN_OWNER_TELEGRAM_ID must be the creator's
# existing MemeX profile.
ADMIN_OWNER_TELEGRAM_ID=
ADMIN_OWNER_KEY=
ADMIN_TELEGRAM_IDS=

# Human payment/support contact. Set this to a real human Telegram username in production.
# It must not be the bot username.
SUPPORT_TELEGRAM_USERNAME=

# Optional: higher TonAPI rate limits
TONAPI_KEY=
