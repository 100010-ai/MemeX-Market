# Supabase — server only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Browser/Realtime key (safe to expose as a public Supabase key)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy alternative:
# SUPABASE_ANON_KEY=...

# Telegram Mini App / Bot API
TELEGRAM_BOT_TOKEN=123456789:AA...

# Server session signing. Generate your own long random value for production.
SESSION_SECRET=replace-with-your-own-random-secret-at-least-32-characters

# Optional Telegram in-app diagnostics admins
ADMIN_TELEGRAM_IDS=123456789

# Optional. TonAPI works without a key at a strict public rate limit.
# Add a server-side key only if you want faster large catalogue imports.
# TONAPI_KEY=...

# No MTProto API_ID/API_HASH/user session is required.
# Local God Mode automatically creates .mxm-control-secret on first local launch.

# AdsGram rewarded ads. Public numeric Reward block ID issued by AdsGram.
# Create a Reward ad unit in the AdsGram publisher dashboard.
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
# Server-only random secret for the Reward URL callback.
# Paste this exact shape into the AdsGram Reward URL field:
# https://YOUR_DOMAIN/api/rewards/ads/adsgram?userid=[userId]&token=YOUR_SECRET
ADSGRAM_REWARD_SECRET=replace-with-a-long-random-server-secret

# Safe-by-default moderation lock. Leave true for the AdsGram submission build.
ADSGRAM_MODERATION_MODE=true
# Third-party incentivized subscription/click campaigns require moderation mode
# to be explicitly disabled AND this flag to be true.
ENABLE_SPONSORED_TASKS=false

# Development-only fallback. Production code ignores `true` and always requires
# server Reward URL verification before changing the virtual balance.
ADSGRAM_ALLOW_CLIENT_FALLBACK=false

# Telegram Stars / referral links
NEXT_PUBLIC_BOT_USERNAME=MemeXMarketBot
# Required in production for /api/telegram/webhook. Use the same value in Bot API setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret

# v0.47 partner task verification
# For Telegram subscription campaigns, add this bot as an administrator
# to the advertised channel/group. Telegram only guarantees getChatMember
# checks for other users when the bot is an administrator of that chat.


# v0.48 background dispatcher for price alerts + Telegram notifications.
# Protect /api/system/notifications-dispatch with this secret.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Public HTTPS Mini App URL. Must exactly match BotFather / AdsGram platform settings.
# Also used for notification buttons and `npm run adsgram:check`.
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
