# Supabase — server only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Browser/Reatime key (safe to expose as a public Supabase key)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy alternative:
# SUPABASE_ANON_KEY=...

# Telegram Mini App / Bot API
TELEGRAM_BOT_TOKEN=123456789:AA...

# Server session signing. Generate your own long random value for production.
SESSION_SECRET=replace-with-your-own-random-secret-at-least-32-characters

# Optional Telegram in-app diagnostics admins
ADMIN_TELEGRAM_IDS=123456789

# Optional. TonAPI works without a key at a strict public rate limit.
# Add a server-side key only if you want faster large catalogue imports.
# TONAPI_KEY=...

# No MTProto API_ID/API_HASH/user session is required.
# Local God Mode automatically creates .mxm-control-secret on first local launch.

# AdsGram rewarded ads. Public publisher block ID for the Mini App.
# Create a Rewarded block in the AdsGram publisher dashboard.
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=
# Strongly recommended: server-only secret used by the AdsGram Reward URL callback.
# Generate a long random value and configure this URL in the AdsGram block:
# https://YOUR_DOMAIN/api/rewards/ads/adsgram?userId=[userId]&token=YOUR_SECRET
ADSGRAM_REWARD_SECRET=replace-with-a-long-random-server-secret

# Development-only fallback. Production code ignores `true` and always requires
# server Reward URL verification before changing the virtual balance.
ADSGRAM_ALLOW_CLIENT_FALLBACK=false

# Telegram Stars / referral links
NEXT_PUBLIC_BOT_USERNAME=MemeXMarketBot
# Required in production for /api/telegram/webhook. Use the same value in Bot API setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
