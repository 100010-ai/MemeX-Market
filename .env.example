# Supabase — server only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase — public key used only for Realtime/browser connection
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy alternative:
# SUPABASE_ANON_KEY=...

# Telegram Mini App / Bot API
TELEGRAM_BOT_TOKEN=123456789:AA...
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Global Telegram collectible resale catalogue (MTProto user session).
# Create API ID/hash at my.telegram.org, then run: npm run telegram:session
# TELEGRAM_USER_SESSION is as sensitive as an account session/password. Server only.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_USER_SESSION=replace-with-exported-mtcute-session

# Bounded bootstrap/rotation. MXM never imports the whole resale catalogue at once.
MARKET_BOOTSTRAP_MIN_LISTINGS=12
MARKET_CATALOG_TARGET_LISTINGS=36
MARKET_CATALOG_COLLECTIONS_PER_SYNC=12
MARKET_BOOTSTRAP_SCAN_COLLECTIONS=32
MARKET_CATALOG_ITEMS_PER_COLLECTION=4
MARKET_BOOTSTRAP_MAX_PRICE_TON=95

# Optional Telegram in-app diagnostics admin
ADMIN_TELEGRAM_IDS=123456789

# LOCAL-ONLY God Mode. Never enable/configure this on Vercel Production.
MXM_LOCAL_ADMIN_ENABLED=true
MXM_LOCAL_ADMIN_TOKEN=replace-with-a-long-local-token-minimum-24-characters
