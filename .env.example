# Public browser configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BOT_USERNAME=MemeXMarketBot
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional server-side identity overrides for reliable reply detection in groups.
TELEGRAM_BOT_USERNAME=MemeXMarketBot
TELEGRAM_BOT_ID=

# OpenRouter conversational bot. openrouter/free uses free models only.
# Primary is always tried first. Put backup keys in OPENROUTER_API_KEYS separated by commas.
OPENROUTER_PRIMARY_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openrouter/free

# Legacy single-key fallback, optional.
OPENROUTER_API_KEY=

# Session / cron secrets
SESSION_SECRET=
CRON_SECRET=

# Human payment/support contact. Set this to a real human Telegram username in production.
# It must not be the bot username.
SUPPORT_TELEGRAM_USERNAME=

# Optional: higher TonAPI rate limits
TONAPI_KEY=
